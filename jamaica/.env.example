# ── Required ──────────────────────────────────────────────
# Postgres connection string. Locally: postgres://jamaica:jamaica@localhost:5432/jamaica
# Supabase: click "Connect" at the top of the project → "Transaction pooler" (port 6543), with your database
# password filled in. Connections to Supabase are always encrypted (SSL).
DATABASE_URL=
# Long random text used to sign upload tickets and protect sessions: openssl rand -hex 32
SESSION_SECRET=
# Public address of the store, used in payment return links and emails.
SITE_URL=http://localhost:3000

# ── File storage (photos, 3D models, 360° sequences, try-on photos) ──
# Leave empty to store files on this computer in ./storage (fine for local use, NOT for Vercel).
# Supabase → Project Settings → API Keys. Use the SECRET key (sb_secret_…); older projects can put their
# service_role key in SUPABASE_SERVICE_ROLE_KEY instead. Server only: never in the browser or in chat.
# The publishable key (sb_publishable_…) is NOT used: the store reads its database only from the server,
# and every table has Row Level Security on with no public access.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=media
SUPABASE_PRIVATE_BUCKET=private

# ── Payments: Mercado Pago (credit card, debit card, PIX with automatic confirmation) ──
# Mercado Pago → Your integrations → Credentials. Without it, only direct PIX (store's own key, confirmed by staff) is offered.
MERCADOPAGO_ACCESS_TOKEN=
# Mercado Pago → Your integrations → Webhooks → secret signature.
MERCADOPAGO_WEBHOOK_SECRET=

# ── Shipping: Melhor Envio (live Correios/Jadlog quotes). Without it, the store's own rate table is used. ──
MELHOR_ENVIO_TOKEN=
# Origin CEP for Melhor Envio quotes (the warehouse).
MELHOR_ENVIO_FROM_CEP=
# Set to "sandbox" to use sandbox.melhorenvio.com.br
MELHOR_ENVIO_ENV=

# ── Virtual try-on: FASHN (https://fashn.ai). Without it, try-on is shown as unavailable. ──
FASHN_API_KEY=
FASHN_MODEL=tryon-v1.6

# ── First owner account ──
# Set any secret phrase (12+ characters), open /admin/setup, create the owner, then DELETE this variable.
OWNER_SETUP_CODE=

# ── Scheduled jobs (Vercel Cron sends this as a Bearer token) ──
CRON_SECRET=
